{
  "description": "Quoth self-learning hooks: trajectory capture on tool use, pattern injection on session start, RL annotation",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/../hooks/trajectory-capture.js\"",
            "timeout": 3000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/../hooks/inject-patterns.js\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
